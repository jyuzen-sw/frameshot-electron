{
  "name": "frameshot-electron",
  "productName": "FrameShot",
  "version": "0.1.0",
  "description": "A focused Windows app for creating polished promotional screenshots of self-hosted web apps.",
  "main": ".vite/build/main.js",
  "author": "FrameShot contributors",
  "license": "MIT",
  "private": true,
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=26.0.0 <27",
    "npm": ">=11.0.0 <12"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package && npm run verify:fuses",
    "make": "npm run make:windows",
    "make:windows": "electron-forge make --platform=win32 --arch=x64",
    "generate:windows-icon": "electron scripts/generate-windows-icon.cjs",
    "audit": "npm audit --audit-level=low",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run package && playwright test",
    "verify": "npm run typecheck && npm run test",
    "verify:fuses": "node scripts/verify-fuses.mjs",
    "verify:windows-artifacts": "node scripts/verify-windows-artifacts.mjs",
    "demo": "node scripts/demo-server.mjs",
    "test:e2e:prepared": "playwright test"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.0-alpha.10",
    "@electron-forge/maker-squirrel": "8.0.0-alpha.10",
    "@electron-forge/plugin-fuses": "8.0.0-alpha.10",
    "@electron-forge/plugin-vite": "8.0.0-alpha.10",
    "@electron-forge/shared-types": "8.0.0-alpha.10",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.4",
    "daisyui": "5.7.9",
    "electron": "43.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "tmp": "0.2.7"
  },
  "config": {
    "forge": "./forge.config.ts"
  }
}
